# ---------- Node / 前端 ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
.eslintcache
coverage/
playwright-report/
test-results/

# ---------- Rust / Tauri ----------
target/
**/target/
src-tauri/gen/
*.rs.bk

# ---------- 构建产物与本地数据 ----------
/release/
/artifacts/

# ---------- 本地环境相关（故意不提交）----------
# Cargo 镜像源属于「本机网络环境」的配置，不是项目配置。
# 提交它会让 GitHub 上的 CI runner 也去访问国内镜像，反而变慢甚至失败。
# 需要时用 scripts/setup/cargo-mirror.mjs 在本地生成。
/.cargo/config.toml
/.toolchain-install.log
/.rust-toolchain.log
/.msvc-install.log
/.cargo-check.log
/.cargo-clippy.log
/.cargo-test.log
/.tauri-build.log
/.app-run.log
/.preview.log

# ---------- 环境与凭据（严禁提交）----------
.env
.env.*
!.env.example
*.pem
*.key
*.key.gpg
*.pfx
*.p12
*.jks
# 注意：这两条通配会命中任何名为 secrets/ 或 credentials/ 的目录，
# 包括**源码目录**。`crates/credentials` 就是被这两条误伤过的真实事故：
# 它没有被提交，导致 CI 上 cargo 找不到 workspace 成员而直接失败
# （报错形如 "failed to load manifest for workspace member .../src-tauri"）。
# 因此下面紧跟例外规则，且 scripts/ci/validate-repo.mjs 会做自动化断言。
**/secrets/**
**/credentials/**
!crates/credentials/
!crates/credentials/**
portable-data/

# ---------- 编辑器 / 系统 ----------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# ---------- 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
.cache/
