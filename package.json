{
  "name": "forgedesk",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "ForgeDesk — A Git client for everyone",
  "license": "Apache-2.0",
  "author": "ForgeDesk contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ember1414/forgedesk.git"
  },
  "homepage": "https://github.com/Ember1414/forgedesk#readme",
  "bugs": {
    "url": "https://github.com/Ember1414/forgedesk/issues"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "i18n:lint": "node scripts/i18n/lint-i18n.mjs",
    "i18n:check": "node scripts/i18n/check-i18n-keys.mjs",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:contrast": "node scripts/design/check-contrast.mjs",
    "check:colors": "node scripts/design/scan-color-literals.mjs",
    "check:workflows": "node scripts/ci/validate-workflows.mjs",
    "check:ipc": "node scripts/ci/check-ipc-args.mjs",
    "check:repo": "node scripts/ci/validate-repo.mjs",
    "check:docs": "node scripts/ci/check-docs-links.mjs",
    "//check:site": "官网落地页自检：用 jsdom 跑一遍页面脚本，断言「有/无发布清单」两种状态下的下载入口",
    "check:site": "node scripts/ci/check-site.mjs",
    "compliance": "node scripts/compliance/check.mjs",
    "setup:cargo-mirror": "node scripts/setup/cargo-mirror.mjs",
    "portable:win": "node scripts/ci/make-portable.mjs --out bundles",
    "version:sync": "node scripts/setup/sync-version.mjs",
    "version:check": "node scripts/setup/sync-version.mjs --check",
    "//release:rehearse": "本地演练发布脚本链（假产物），不需要任何凭据；覆盖脚本之间的接口与顺序，不覆盖 tauri build / 签名 / Release / Pages",
    "release:rehearse": "node scripts/ci/rehearse-release.mjs",
    "site:screenshots": "node scripts/site/capture-screenshots.mjs",
    "//pages": "使用 npx 而非 pnpm dlx：pnpm 在遇到需要构建的依赖（esbuild/workerd）时会弹出交互式选择框，且 dlx 的隔离环境不读取项目的 pnpm 配置，脚本化场景下会直接卡住。",
    "pages:preview": "npx --yes wrangler@4 pages dev site",
    "pages:deploy": "npx --yes wrangler@4 pages deploy site --project-name=forgedesk",
    "//pages:create": "一次性引导步骤：项目 forgedesk 已于 2026-09-23 创建，重复执行会以 code 8000002（already exists）失败——那是预期结果，不是故障。保留此脚本是为了让流程能在全新账号上自举。",
    "pages:create": "npx --yes wrangler@4 pages project create forgedesk --production-branch=main",
    "tauri": "tauri"
  },
  "packageManager": "pnpm@11.7.0",
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-radio-group": "^1.4.7",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toast": "^1.2.23",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.103.2",
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "i18next": "^26.4.2",
    "lucide-react": "^1.47.0",
    "monaco-editor": "0.52.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "yaml": "^2.9.1"
  }
}
