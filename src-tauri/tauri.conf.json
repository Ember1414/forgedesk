{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgeDesk",
  "version": "0.7.0",
  "identifier": "io.github.ember1414.forgedesk",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgeDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: asset: http://asset.localhost https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis", "dmg", "app", "appimage", "deb", "rpm"],
    "resources": {
      "../plugins/examples": "examples/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "ForgeDesk — A Git client",
    "longDescription": "ForgeDesk 是一个开源、跨平台的 Git 桌面工作台：把复杂的 Git 与 GitHub 终端操作变成可视化界面、向导与可交互图表。破坏性操作一律先预览计划并自动快照，可随时回滚；凭据只存系统钥匙串，日志与错误详情在写出前统一脱敏；所有数据保存在本地，无遥测、无 AI 推理功能。",
    "copyright": "ForgeDesk contributors",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0", "libsecret-1-0"]
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "wix": {
        "language": ["en-US", "zh-CN"]
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh"
      }
    }
  }
}
